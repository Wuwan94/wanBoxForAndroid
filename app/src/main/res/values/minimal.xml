<?xml version="1.0" ?>
<resources>
    <color name="minimal_background">#FFFFFF</color>
    <color name="minimal_card">#FAFAFB</color>
    <color name="minimal_selected">#F1F2F3</color>
    <color name="minimal_segment">#F7F7F8</color>
    <color name="minimal_active">#E7E8EA</color>
    <color name="minimal_text">#18191B</color>
    <color name="minimal_secondary">#70757C</color>
    <color name="minimal_line">#ECEDEF</color>
    <color name="minimal_icon">#565B63</color>
    <style name="Widget.WanBox.Minimal.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/minimal_card</item>
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/minimal_line</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.WanBox.Minimal.Segment" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/minimal_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
    </style>
    <style name="Widget.WanBox.Minimal.Action" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/minimal_text</item>
        <item name="iconTint">@color/minimal_icon</item>
        <item name="strokeColor">@color/minimal_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="iconSize">20dp</item>
    </style>
    <style name="TextAppearance.WanBox.Minimal.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/minimal_text</item>
    </style>
    <style name="TextAppearance.WanBox.Minimal.Nav" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
    </style>
    <string name="minimal_overview">%1$d 个订阅 · %2$d 个节点</string>
