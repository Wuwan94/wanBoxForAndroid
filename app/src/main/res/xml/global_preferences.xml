<?xml version="1.0" encoding="utf-8"?>
<!-- @author 雾晚 -->
<!-- 四组重组：外观 / 运行 / 维护与诊断 / 关于 + 高级设置 -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 1. 外观：主题、语言、界面 -->
    <moe.matsuri.nb4a.ui.ExpandablePreferenceCategory
        app:key="categoryAppearance"
        app:title="@string/settings_group_appearance">

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="0"
            app:entries="@array/card_style_entries"
            app:entryValues="@array/card_style_values"
            app:icon="@drawable/ic_line_list"
            app:key="profileCardStyle"
            app:title="@string/card_style"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreference
            app:defaultValue="true"
            app:key="profileTrafficStatistics"
            app:summary="@string/profile_traffic_statistics_summary"
            app:title="@string/profile_traffic_statistics" />

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_minimal_globe"
            app:key="showLandingIp"
            app:summary="@string/show_landing_ip_sum"
            app:title="@string/show_landing_ip"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreference
            app:icon="@drawable/ic_line_filter"
            app:key="alwaysShowAddress"
            app:summary="@string/always_show_address_sum"
            app:title="@string/always_show_address" />

        <SwitchPreference
            app:defaultValue="true"
            app:key="confirmProfileDelete"
            app:title="@string/confirm_profile_delete" />

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_line_cloud"
            app:key="show_subscription_info_card"
            app:summary="@string/show_subscription_info_card_summary"
            app:title="@string/show_subscription_info_card" />

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="0"
            app:entries="@array/night_mode"
            app:entryValues="@array/int_array_4"
            app:icon="@drawable/ic_line_sun"
            app:key="nightTheme"
            app:title="@string/night_mode"
            app:useSimpleSummaryProvider="true" />

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue=""
            app:entries="@array/language_entries"
            app:entryValues="@array/language_values"
            app:icon="@drawable/ic_line_translate"
            app:key="appLanguage"
            app:title="@string/language"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreference
            app:defaultValue="true"
            app:key="hapticFeedback"
            app:title="@string/haptic_feedback"
            app:summary="@string/haptic_feedback_summary" />

    </moe.matsuri.nb4a.ui.ExpandablePreferenceCategory>

    <!-- 2. 运行：Root模块状态、连接、分应用 -->
    <moe.matsuri.nb4a.ui.ExpandablePreferenceCategory
        app:key="categoryRuntime"
        app:title="@string/settings_group_runtime">


        <SwitchPreference
            app:defaultValue="false"
            app:icon="@drawable/ic_line_block"
            app:key="disableMixedInbound"
            app:summary="@string/disable_mixed_inbound_sum"
            app:title="@string/disable_mixed_inbound" />

        <!-- @author 雾晚：mixed 相关项由 Fragment 代码按 disableMixedInbound 联动禁用 -->
        <EditTextPreference
            app:icon="@drawable/ic_line_route"
            app:key="mixedPort"
            app:title="@string/port_proxy"
            app:useSimpleSummaryProvider="true" />

        <Preference
            app:icon="@drawable/ic_line_lock"
            app:key="mixedAuthConfig"
            app:title="@string/mixed_auth_config" />

        <Preference
            app:icon="@drawable/ic_line_share"
            app:key="lanSharing"
            app:title="@string/lan_sharing" />

        <SwitchPreference
            app:icon="@drawable/ic_minimal_sliders"
            app:key="bypassLan"
            app:title="@string/route_opt_bypass_lan" />

        <SwitchPreference
            app:key="bypassLanInCore"
            app:title="@string/bypass_lan_in_core" />

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_line_shield"
            app:key="strictRoute"
            app:summary="@string/strict_route_sum"
            app:title="@string/strict_route" />


        <moe.matsuri.nb4a.ui.MTUPreference
            app:defaultValue="9000"
            app:entries="@array/mtu_select"
            app:entryValues="@array/mtu_select"
            app:icon="@drawable/ic_minimal_globe"
            app:key="mtu"
            app:title="@string/mtu" />

        <SwitchPreference
            app:defaultValue="false"
            app:icon="@drawable/ic_line_gauge"
            app:key="performancePriorityMode"
            app:summary="@string/performance_priority_mode_summary"
            app:title="@string/performance_priority_mode" />

    </moe.matsuri.nb4a.ui.ExpandablePreferenceCategory>

    <!-- 3. 维护与诊断：日志、测速、诊断 -->
    <moe.matsuri.nb4a.ui.ExpandablePreferenceCategory
        app:key="categoryMaintenance"
        app:title="@string/settings_group_maintenance">

        <moe.matsuri.nb4a.ui.UrlTestPreference
            app:defaultValue="@string/default_connection_test_url"
            app:icon="@drawable/ic_line_cast"
            app:key="connectionTestURL"
            app:title="@string/connection_test_url"
            app:useSimpleSummaryProvider="true" />

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="@string/default_speed_test_mode"
            app:entries="@array/speed_test_modes"
            app:entryValues="@array/speed_test_mode_values"
            app:key="speedTestMode"
            app:title="@string/speed_test_mode"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue="@string/default_speed_test_timeout_ms"
            app:key="speedTestTimeoutMs"
            app:title="@string/speed_test_timeout_ms"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue="@string/default_simple_download_url"
            app:key="simpleDownloadURL"
            app:title="@string/simple_download_url"
            app:useSimpleSummaryProvider="true" />

    </moe.matsuri.nb4a.ui.ExpandablePreferenceCategory>

    <!-- 高级设置：DNS、核心、分片、进阶（保留所有 key） -->
    <moe.matsuri.nb4a.ui.ExpandablePreferenceCategory
        app:key="categoryAdvancedGroup"
        app:title="@string/settings_group_advanced">
        <SwitchPreference app:key="smartAutoStopEnabled" app:defaultValue="false" app:title="@string/smart_auto_stop_title" />
        <EditTextPreference app:key="smartAutoStopRules" app:defaultValue="" app:title="@string/smart_auto_stop_rules" app:summary="@string/smart_auto_stop_rules_hint" />
        <Preference app:key="smartAutoStopPermission" app:title="@string/smart_auto_stop_permission" app:persistent="false" />

        <EditTextPreference
            app:defaultValue="https://dns.google/dns-query"
            app:icon="@drawable/ic_line_server"
            app:key="remoteDns"
            app:title="@string/remote_dns"
            app:useSimpleSummaryProvider="true" />

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="auto"
            app:entries="@array/dns_network_select"
            app:entryValues="@array/dns_network_select"
            app:key="domain_strategy_for_remote"
            app:title="@string/domain_strategy_for_remote"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue="https://223.5.5.5/dns-query"
            app:icon="@drawable/ic_line_server"
            app:key="directDns"
            app:title="@string/direct_dns"
            app:useSimpleSummaryProvider="true" />

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="auto"
            app:entries="@array/dns_network_select"
            app:entryValues="@array/dns_network_select"
            app:key="domain_strategy_for_direct"
            app:title="@string/domain_strategy_for_direct"
            app:useSimpleSummaryProvider="true" />

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="auto"
            app:entries="@array/dns_network_select"
            app:entryValues="@array/dns_network_select"
            app:key="domain_strategy_for_server"
            app:title="@string/domain_strategy_for_server"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_line_qr"
            app:key="enableDnsRouting"
            app:summary="@string/dns_routing_message"
            app:title="@string/enable_dns_routing" />

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_line_lock"
            app:key="enableFakeDns"
            app:summary="@string/fakedns_message"
            app:title="@string/enable_fakedns" />

        <EditTextPreference
            app:defaultValue=""
            app:dialogMessage="@string/dns_hosts_dialog_message"
            app:icon="@drawable/ic_line_swap"
            app:key="dnsHosts"
            app:title="@string/dns_hosts"
            app:useSimpleSummaryProvider="true" />

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="1"
            app:entries="@array/traffic_sniffing_values"
            app:entryValues="@array/int_array_2"
            app:icon="@drawable/ic_minimal_search"
            app:key="trafficSniffing"
            app:title="@string/traffic_sniffing"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_line_shield"
            app:key="blockQuic"
            app:summary="@string/core_block_quic_summary"
            app:title="@string/core_block_quic_title" />

        <SwitchPreference
            app:icon="@drawable/ic_line_text"
            app:key="resolveDestination"
            app:summary="@string/resolve_destination_summary"
            app:title="@string/resolve_destination" />

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="0"
            app:entries="@array/ipv6_mode"
            app:entryValues="@array/int_array_4"
            app:icon="@drawable/ic_minimal_layers"
            app:key="ipv6Mode"
            app:title="@string/ipv6"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreference
            app:icon="@drawable/ic_line_swap"
            app:key="dualNetworkAcceleration"
            app:summary="@string/dual_network_acceleration_summary"
            app:title="@string/dual_network_acceleration" />

        <SwitchPreference
            app:icon="@drawable/ic_line_gauge"
            app:key="concurrentDial"
            app:summary="@string/concurrent_dial_summary"
            app:title="@string/concurrent_dial" />

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="0"
            app:entries="@array/rules_dat_provider"
            app:entryValues="@array/int_array_5"
            app:icon="@drawable/ic_line_file"
            app:key="rulesProvider"
            app:title="@string/route_rules_provider"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue="https://github.com/SagerNet/sing-geosite/releases/latest/download/geosite.db"
            app:key="rulesGeositeUrl"
            app:title="@string/rules_geosite_url"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue="https://github.com/SagerNet/sing-geoip/releases/latest/download/geoip.db"
            app:key="rulesGeoipUrl"
            app:title="@string/rules_geoip_url"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue="0"
            app:icon="@drawable/ic_line_gauge"
            app:key="rulesUpdateInterval"
            app:summary="@string/ruleset_update_interval_summary"
            app:title="@string/ruleset_update_interval" />

        <!-- 6. 分片 (Fragment) 设置 -->
        <moe.matsuri.nb4a.ui.ExpandablePreferenceCategory
            app:key="categoryFragment"
            app:title="@string/fragment_settings">

            <SwitchPreference
                app:key="enableTLSFragment"
                app:title="@string/enable_tls_fragment" />

            <EditTextPreference
                app:defaultValue="100-200"
                app:key="fragmentLength"
                app:title="@string/fragment_length"
                app:useSimpleSummaryProvider="true" />

            <EditTextPreference
                app:defaultValue="10-20"
                app:key="fragmentInterval"
                app:title="@string/fragment_interval"
                app:useSimpleSummaryProvider="true" />

        </moe.matsuri.nb4a.ui.ExpandablePreferenceCategory>

        <io.nekohasekai.sagernet.widget.SubscriptionUserAgentPreference
            app:icon="@drawable/ic_line_http"
            app:key="defaultSubscriptionUserAgent"
            app:title="@string/default_subscription_user_agent" />

        <!-- @author 雾晚：Root 必需内部接口，固定启用，不提供误导开关 -->

        <SwitchPreference
            app:icon="@drawable/ic_line_unlock"
            app:key="globalAllowInsecure"
            app:summary="@string/security_allow_insecure_warning"
            app:title="@string/global_allow_insecure" />

        <SwitchPreference
            app:key="allowInsecureOnRequest"
            app:title="@string/allow_insecure_on_request_sum" />

        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="1.2"
            app:entries="@array/app_tls_version"
            app:entryValues="@array/app_tls_version"
            app:key="appTLSVersion"
            app:title="@string/app_tls_version"
            app:useSimpleSummaryProvider="true" />

        <moe.matsuri.nb4a.ui.LongClickListPreference
            app:defaultValue="0"
            app:entries="@array/log_level"
            app:entryValues="@array/int_array_5"
            app:icon="@drawable/ic_line_bug"
            app:key="logLevel"
            app:title="@string/log_level"
            app:useSimpleSummaryProvider="true" />

        <moe.matsuri.nb4a.ui.EditConfigPreference
            app:icon="@drawable/ic_minimal_layers"
            app:key="globalCustomConfig"
            app:summary="@string/advanced_json_warning"
            app:title="@string/custom_config"
            app:useSimpleSummaryProvider="true" />

        <Preference
            app:icon="@drawable/ic_line_trash"
            app:key="clearCache"
            app:summary="@string/clear_cache_summary"
            app:title="@string/clear_cache" />

        <Preference
            app:icon="@drawable/ic_line_undo"
            app:key="resetSettings"
            app:summary="@string/reset_settings_warning"
            app:title="@string/reset_settings" />

    </moe.matsuri.nb4a.ui.ExpandablePreferenceCategory>

</PreferenceScreen>
