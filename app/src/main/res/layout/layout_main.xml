<?xml version="1.0" encoding="utf-8"?>
<!-- @author 雾晚 -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:background="@color/minimal_background">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/fragment_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- preview.19: 移除悬浮小飞机按钮，连接操作统一在仪表盘 -->

        <!-- remove(D3): 底部 StatsBar 宿主已删除；连接测试 / 落地 IP 迁到首页「连接检查」卡片 -->

        <!-- preview.18 UI 改造：底部导航 -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/minimal_background"
            android:minHeight="64dp"
            app:elevation="0dp"
            app:labelVisibilityMode="labeled"
            app:itemHorizontalTranslationEnabled="false"
            app:itemBackground="@drawable/bg_minimal_bottom_nav"
            app:itemIconSize="22dp"
            app:itemTextAppearanceActive="@style/TextAppearance.WanBox.Minimal.Nav"
            app:itemTextAppearanceInactive="@style/TextAppearance.WanBox.Minimal.Nav"
            app:itemIconTint="@color/minimal_nav_tint"
            app:itemTextColor="@color/minimal_nav_tint"
            app:menu="@menu/bottom_nav_menu" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
