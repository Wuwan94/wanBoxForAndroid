<?xml version="1.0" encoding="utf-8"?>
<!-- @author 雾晚 -->
<!-- preview.20: 内容权重占剩余空间，底部导航 wrap_content，避免遮挡 -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:statusBarBackground="@android:color/transparent"
    tools:openDrawer="start">

    <LinearLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 内容区域：0dp 权重占剩余空间 -->
        <FrameLayout
            android:id="@+id/fragment_holder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <!-- 底部导航：wrap_content，语义主题色支持深色与选中状态 -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ref_nav_height"
            android:background="@color/ref_background"
            app:elevation="0dp"
            app:labelVisibilityMode="labeled"
            app:itemHorizontalTranslationEnabled="false"
            app:itemIconSize="24dp"
            app:itemBackground="@drawable/ref_nav_item"
            app:itemTextAppearanceActive="@style/TextAppearance.WanBox.ReferenceNav"
            app:itemTextAppearanceInactive="@style/TextAppearance.WanBox.ReferenceNav"
            app:itemIconTint="@color/ref_nav_tint"
            app:itemTextColor="@color/ref_nav_tint"
            app:menu="@menu/bottom_nav_menu" />

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        style="@style/Widget.MaterialComponents.NavigationView"
        app:insetForeground="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:itemIconTint="@color/navigation_icon"
        app:itemShapeAppearance="@style/ShapeAppearance.SagerNet.NavItem"
        app:itemShapeFillColor="@color/nav_item_fill"
        app:itemShapeInsetStart="8dp"
        app:itemShapeInsetEnd="8dp"
        app:itemShapeInsetTop="3dp"
        app:itemShapeInsetBottom="3dp"
        app:itemTextColor="@color/navigation_text"
        app:menu="@menu/main_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
