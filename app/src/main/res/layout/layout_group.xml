<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/minimal_background">
    <include layout="@layout/layout_appbar"/>
    <TextView android:id="@+id/subscriptions_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/ui_page_horizontal" android:paddingBottom="8dp" android:textSize="13sp" android:textColor="@color/minimal_secondary"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/ui_page_horizontal" android:layout_marginBottom="4dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/subscriptions_update_all" style="@style/Widget.WanBox.Minimal.Action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="@string/minimal_update_all" app:icon="@drawable/ic_minimal_refresh"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/subscriptions_update_selected" style="@style/Widget.WanBox.Minimal.Action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" app:icon="@drawable/ic_minimal_check"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <com.simplecityapps.recyclerview_fastscroll.views.FastScrollRecyclerView android:id="@+id/group_list" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="@dimen/ui_form_padding" android:clipToPadding="false" android:scrollbarSize="0dp" app:fastScrollAutoHide="true" app:fastScrollThumbColor="@color/minimal_icon"/>
        <TextView android:id="@+id/subscriptions_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:padding="20dp" android:text="@string/minimal_settings_empty" android:textSize="14sp" android:textColor="@color/minimal_secondary" android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>
