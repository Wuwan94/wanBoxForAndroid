<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="4dp" android:paddingBottom="6dp" android:background="@color/minimal_background">
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/minimal_line"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/node_display_settings" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/minimal_text"/>
        <ImageButton android:id="@+id/display_settings_close" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_navigation_close" android:tint="@color/minimal_secondary" android:padding="14dp" android:contentDescription="@android:string/cancel"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="@string/node_column_count" android:textColor="@color/minimal_secondary" android:textSize="12sp"/>
        <RadioGroup android:id="@+id/columnCountGroup" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_minimal_segment">
            <RadioButton android:id="@+id/radioSingle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:button="@null" android:padding="0dp" android:gravity="center" android:text="@string/node_column_single" android:textSize="12sp" android:textColor="@color/minimal_text" android:background="@drawable/bg_minimal_nav"/>
            <RadioButton android:id="@+id/radioDouble" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:button="@null" android:padding="0dp" android:gravity="center" android:text="@string/node_column_double" android:textSize="12sp" android:textColor="@color/minimal_text" android:background="@drawable/bg_minimal_nav"/>
            <RadioButton android:id="@+id/radioMulti" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:button="@null" android:padding="0dp" android:gravity="center" android:text="@string/node_column_multi" android:textSize="12sp" android:textColor="@color/minimal_text" android:background="@drawable/bg_minimal_nav"/>
        </RadioGroup>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
        <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="@string/node_name_text_size" android:textSize="12sp" android:textColor="@color/minimal_secondary"/>
        <SeekBar android:id="@+id/textSizeSeekBar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:min="10" android:max="24" android:progressTint="@color/minimal_icon" android:thumbTint="@color/minimal_icon"/>
        <TextView android:id="@+id/display_text_size_value" android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="end" android:textSize="12sp" android:textColor="@color/minimal_secondary"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
        <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="@string/node_card_spacing" android:textSize="12sp" android:textColor="@color/minimal_secondary"/>
        <SeekBar android:id="@+id/spacingSeekBar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:min="0" android:max="20" android:progressTint="@color/minimal_icon" android:thumbTint="@color/minimal_icon"/>
        <TextView android:id="@+id/display_spacing_value" android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="end" android:textSize="12sp" android:textColor="@color/minimal_secondary"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="@string/node_card_density" android:textColor="@color/minimal_secondary" android:textSize="12sp"/>
        <RadioGroup android:id="@+id/densityGroup" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_minimal_segment">
            <RadioButton android:id="@+id/radioSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:button="@null" android:padding="0dp" android:gravity="center" android:text="@string/node_card_small" android:textSize="12sp" android:textColor="@color/minimal_text" android:background="@drawable/bg_minimal_nav"/>
            <RadioButton android:id="@+id/radioMedium" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:button="@null" android:padding="0dp" android:gravity="center" android:text="@string/node_card_medium" android:textSize="12sp" android:textColor="@color/minimal_text" android:background="@drawable/bg_minimal_nav"/>
            <RadioButton android:id="@+id/radioLarge" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:button="@null" android:padding="0dp" android:gravity="center" android:text="@string/node_card_large" android:textSize="12sp" android:textColor="@color/minimal_text" android:background="@drawable/bg_minimal_nav"/>
        </RadioGroup>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/minimal_display_hint" android:textColor="@color/minimal_secondary" android:textSize="11sp"/>
</LinearLayout>
