<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/minimal_background"
    android:orientation="vertical">

    <include layout="@layout/layout_appbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ui_page_horizontal"
            android:paddingTop="@dimen/ui_page_top"
            android:paddingBottom="@dimen/ui_page_bottom">

            <!-- phase2 首页视觉中心：吉祥物 + 大圆形连接按钮（未连接/连接中/已连接/异常 四态） -->
            <ImageView
                android:id="@+id/mascot"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mascot_sleep" />

            <FrameLayout
                android:layout_width="188dp"
                android:layout_height="188dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xs">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/connectProgress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    android:visibility="invisible"
                    app:indicatorColor="?attr/colorPrimary"
                    app:indicatorSize="184dp"
                    app:trackThickness="4dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/connectButton"
                    android:layout_width="164dp"
                    android:layout_height="164dp"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:contentDescription="@string/minimal_connection_toggle"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/connect_idle_fill"
                    app:cardCornerRadius="82dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/connectIcon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_minimal_power"
                            app:tint="@color/connect_idle_on" />

                        <TextView
                            android:id="@+id/connectLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/home_action_connect"
                            android:textColor="@color/connect_idle_on"
                            android:textSize="18sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/service_state_idle"
                android:textColor="@color/minimal_text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/statusDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_l"
                android:gravity="center"
                android:text="@string/home_hint_idle"
                android:textColor="@color/minimal_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFailover"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/space_l"
                android:text="@string/home_failover"
                android:visibility="gone"
                app:icon="@drawable/ic_line_swap" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WanBox.Minimal.DashboardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ui_card_spacing">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/minimal_current_node"
                        android:textColor="@color/minimal_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/currentNodeLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="64dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingVertical="8dp">

                            <TextView
                                android:id="@+id/nodeName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="2"
                                android:text="—"
                                android:textColor="@color/minimal_text"
                                android:textSize="21sp" />

                            <TextView
                                android:id="@+id/nodeInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/jetbrains_mono"
                                android:text="—"
                                android:textColor="@color/minimal_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_minimal_chevron" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:textAppearance="@style/TextAppearance.WanBox.Minimal.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/minimal_routing_mode"
                android:textColor="@color/minimal_text"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/modeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="@dimen/ui_card_spacing"
                android:background="@drawable/bg_dashboard_segment"
                android:padding="2dp">

                <Button
                    android:id="@+id/modeRule"
                    style="@style/Widget.WanBox.Minimal.DashboardSegment"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="80dp"
                    android:text="@string/minimal_rule" />

                <Button
                    android:id="@+id/modeGlobal"
                    style="@style/Widget.WanBox.Minimal.DashboardSegment"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="80dp"
                    android:text="@string/minimal_global" />

                <Button
                    android:id="@+id/modeDirect"
                    style="@style/Widget.WanBox.Minimal.DashboardSegment"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="80dp"
                    android:text="@string/minimal_direct" />
            </LinearLayout>

            <!-- D3: 连接测试 / 落地 IP 从已删除的底部 StatsBar 迁到首页；首页「更新订阅」 -->
            <TextView
                android:textAppearance="@style/TextAppearance.WanBox.Minimal.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/minimal_quick_check"
                android:textColor="@color/minimal_text"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WanBox.Minimal.DashboardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ui_card_spacing">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="40dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/minimal_connection_test"
                            android:textColor="@color/minimal_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/connectionTestResult"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/jetbrains_mono"
                            android:gravity="end"
                            android:text="—"
                            android:textColor="@color/minimal_text"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/landingIpLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="40dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/minimal_landing_ip"
                            android:textColor="@color/minimal_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/landingIpText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:ellipsize="middle"
                            android:gravity="end"
                            android:singleLine="true"
                            android:text="—"
                            android:textColor="@color/minimal_text"
                            android:textSize="14sp" />

                        <ImageButton
                            android:id="@+id/btnLandingIp"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/minimal_landing_ip_refresh"
                            android:padding="10dp"
                            android:src="@drawable/ic_minimal_refresh"
                            app:tint="@color/minimal_icon" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTestConnection"
                            style="@style/Widget.WanBox.Minimal.Action"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="@string/minimal_connection_test"
                            app:icon="@drawable/ic_minimal_globe" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpdateSubscription"
                            style="@style/Widget.WanBox.Minimal.Action"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="@string/minimal_update_subscription"
                            app:icon="@drawable/ic_minimal_subscription" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:textAppearance="@style/TextAppearance.WanBox.Minimal.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/home_runtime_title"
                android:textColor="@color/minimal_text"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.WanBox.Minimal.DashboardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ui_card_spacing">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:minHeight="100dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/minimal_upload"
                            android:textColor="@color/minimal_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/uploadSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:text="—"
                            android:textColor="@color/minimal_data"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/uploadTotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:text="—"
                            android:textColor="@color/minimal_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="14dp"
                        android:background="@color/minimal_line" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/minimal_download"
                            android:textColor="@color/minimal_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/downloadSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:text="—"
                            android:textColor="@color/minimal_data"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/downloadTotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:text="—"
                            android:textColor="@color/minimal_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="@color/minimal_line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:minHeight="78dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/minimal_uptime"
                            android:textColor="@color/minimal_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/uptimeText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:gravity="center"
                            android:text="—"
                            android:textColor="@color/minimal_text"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@color/minimal_line" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/minimal_connections"
                            android:textColor="@color/minimal_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/connectionCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:gravity="center"
                            android:text="—"
                            android:textColor="@color/minimal_text"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@color/minimal_line" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/minimal_memory"
                            android:textColor="@color/minimal_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/coreMemory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:gravity="center"
                            android:text="—"
                            android:textColor="@color/minimal_text"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
