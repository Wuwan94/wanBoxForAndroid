<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/minimal_background"
    android:orientation="vertical"
    tools:context=".ui.ConfigurationFragment">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView android:id="@+id/nodes_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/ui_page_horizontal" android:paddingBottom="@dimen/ui_space_medium" android:textColor="@color/minimal_secondary" android:textSize="@dimen/ui_text_supporting"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/group_tab"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="@dimen/ui_page_horizontal"
        android:background="@drawable/bg_minimal_segment"
        android:elevation="0dp"
        android:visibility="gone"
        app:tabIndicatorColor="?attr/tabIndicatorColor"
        app:tabIndicatorHeight="0dp"
        app:tabIndicatorFullWidth="false"
        app:tabMode="scrollable"
        app:tabPaddingStart="@dimen/ui_form_padding"
        app:tabBackground="@drawable/bg_minimal_tab"
        app:tabPaddingEnd="@dimen/ui_form_padding"
        app:tabRippleColor="?tabRippleColor"
        app:tabSelectedTextColor="?attr/tabSelectedTextColor"
        app:tabTextColor="?attr/tabTextColor"
        app:tabTextAppearance="@style/Widget.SagerNet.TabLayout.TextAppearance"
        app:tabUnboundedRipple="false" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/group_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />

    <include android:id="@+id/node_display_panel" layout="@layout/dialog_node_display_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>
</LinearLayout>