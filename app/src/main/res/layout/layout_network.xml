<?xml version="1.0" encoding="utf-8"?>
<!-- @author 雾晚：工具页精简——去掉与设置重复的局域网共享/本地备份卡片，统一卡片样式与间距 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/minimal_background"
    android:clipToPadding="false"
    android:paddingBottom="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:accessibilityHeading="true"
            android:text="@string/tools_section_network"
            android:textColor="@color/minimal_secondary"
            android:textSize="13sp" />

        <!-- DNS 解析地址 / trace 连通性 / Fake-IP 检查（非完整泄漏测试） -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.WanBox.Minimal.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tools_dns_leak"
                    android:textColor="@color/minimal_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/tools_dns_leak_summary"
                    android:textColor="@color/minimal_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/dnsLeakResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/minimal_text"
                    android:textIsSelectable="true"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/dnsLeakTest"
                    style="@style/Widget.WanBox.Minimal.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:text="@string/start_dns_leak_test" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- STUN（依赖内嵌核心：瘦管理器中隐藏） -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stun_card"
            style="@style/Widget.WanBox.Minimal.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stun_test"
                    android:textColor="@color/minimal_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/stun_test_summary"
                    android:textColor="@color/minimal_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/stunTest"
                    style="@style/Widget.WanBox.Minimal.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:text="@string/start" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:accessibilityHeading="true"
            android:text="@string/tools_section_support"
            android:textColor="@color/minimal_secondary"
            android:textSize="13sp" />

        <!-- 导出诊断日志 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.WanBox.Minimal.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/export_crash_log"
                    android:textColor="@color/minimal_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/tools_crash_log_summary"
                    android:textColor="@color/minimal_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/exportCrashLog"
                    style="@style/Widget.WanBox.Minimal.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:text="@string/export_crash_log" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
