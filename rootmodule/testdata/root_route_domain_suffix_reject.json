  "eligibleRule": {
    "id": 411,
    "enabled": true,
    "domains": "domain:Ads.Example,domain:TRACK.example\ndomain:cdn.example",
    "outbound": -2
  },
  "inputConfig": {
    "route": {
      "rules": [
        {
          "action": "sniff"
        },
        {
          "_wanbox_root_route_domain_suffix_reject_v41": {
            "ruleId": 411,
            "domainText": "domain:Ads.Example,domain:TRACK.example\ndomain:cdn.example"
          }
        },
        {
          "domain": [
            "legacy.example"
          ],
          "outbound": "direct"
        }
      ]
    }
  },
  "expectedConfig": {
