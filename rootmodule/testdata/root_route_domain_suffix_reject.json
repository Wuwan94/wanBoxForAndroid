        "domains": "domain:ads.example",
        "outbound": -2
      }
    },
    {
      "name": "invalid id",
      "rule": {
        "id": 9007199254740992,
        "enabled": true,
        "domains": "domain:ads.example",
        "outbound": -2
      }
    },
    {
      "name": "not reject",
      "rule": {
