# 统一换行符：脚本必须是 LF，否则 Git Bash / CI 里会报 "\r: command not found"
* text=auto

*.sh   text eol=lf
*.kt   text eol=lf
*.kts  text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf

# 二进制：不要做换行转换
*.png  binary
*.jpg  binary
*.webp binary
*.jar  binary
*.zip  binary
*.so   binary
*.aar  binary
